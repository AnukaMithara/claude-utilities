{
  "manifest_version": 3,
  "name": "Claude Utilities",
  "short_name": "Claude Utils",
  "version": "1.0.0",
  "description": "Unofficial tools for claude.ai: auto-accept tool permissions in the tabs you choose, and insert saved prompts in one click.",
  "homepage_url": "https://github.com/AnukaMithara/claude-utilities",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/core/registry.js",
        "src/core/storage.js",
        "src/core/log.js",
        "src/utilities/auto-accept-permissions.js",
        "src/content/runner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Utilities",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
